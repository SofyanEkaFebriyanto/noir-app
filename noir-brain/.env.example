# Salin ke .env lalu isi. JANGAN commit file .env.

# Port server (default 8080)
PORT=8080

# API LLM yang OpenAI-compatible (streaming). Contoh:
# - OpenAI:            https://api.openai.com/v1
# - OpenRouter:        https://openrouter.ai/api/v1
# - Ollama lokal:      http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Direktori database SQLite (dibuat otomatis)
DATA_DIR=./data

# Override system prompt Noir (opsional; kosongkan untuk pakai bawaan)
SYSTEM_PROMPT=
